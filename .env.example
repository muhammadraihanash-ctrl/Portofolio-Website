# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELSEVIER_API_KEY: Elsevier Developer API key for Scopus and ScienceDirect integration.
# Obtainable via https://dev.elsevier.com using institutional academic email (e.g. arfa@staff.uns.ac.id).
ELSEVIER_API_KEY="MY_ELSEVIER_API_KEY"

# ELSEVIER_INST_TOKEN: Optional Institutional Token for Universitas Sebelas Maret (UNS).
# Unlocks higher rate limits (5,000-20,000 requests/week) and full Scopus metadata through the UNS library subscription.
ELSEVIER_INST_TOKEN="MY_ELSEVIER_INST_TOKEN"

# ELSEVIER_SCOPUS_AUTHOR_ID: Scopus Author ID for Nughthoh Arfawi Kurdhi (Default: 55851190200).
ELSEVIER_SCOPUS_AUTHOR_ID="55851190200"

# MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE:
# Optional connection credentials for live MySQL / MariaDB server (database_p2m_mysql.sql).
# When configured and reachable, backend connects to live MySQL (database: portofolio_nught, table: kegiatan_p2m).
# If not configured or offline, backend automatically falls back to /data/database_p2m_mysql.sql.
MYSQL_HOST="projekportofolio1-muhammadraihanash-569a.a.aivencloud.com"
MYSQL_PORT="23220"
MYSQL_USER="my_mysql_user"
MYSQL_PASSWORD="my_mysql_password"
MYSQL_DATABASE="defaultdb"
MYSQL_SSL="REQUIRED"

# SESSION_SECRET: Secret key for signing admin authentication tokens (HMAC-SHA256).
# Set to a strong random string in production (e.g. Vercel Environment Variables).
SESSION_SECRET="kurdhi_academic_secret_uns_2026"
