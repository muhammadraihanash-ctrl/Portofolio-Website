{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api?__route__=/api/:match*"
    },
    {
      "source": "/((?!api(?:/.*)?).*)",
      "destination": "/index.html"
    }
  ]
}
