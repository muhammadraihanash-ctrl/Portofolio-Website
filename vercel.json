{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.ts?__route__=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts?__route__=/api/$1"
    },
    {
      "source": "/((?!api(?:/.*)?).*)",
      "destination": "/index.html"
    }
  ]
}
